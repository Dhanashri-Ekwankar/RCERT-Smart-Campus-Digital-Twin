# RCERT Smart Campus Digital Twin 2.0 — Environment Configuration
# Copy this file to .env for local overrides (never commit .env to version control)

# Server Environment
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5001

# Optional Database Connection (Defaults to SQLite in database/campus_twin.db)
# For serverless / Vercel production persistence, provide a PostgreSQL connection URL
DATABASE_URL=postgresql://user:password@host:port/database

# External Meteorological & Air Quality APIs (Public / Free Tier)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_AIR_URL=https://air-quality-api.open-meteo.com/v1
RCERT_LATITUDE=19.9501
RCERT_LONGITUDE=79.2993
RCERT_TIMEZONE=Asia/Kolkata
